<?xml version="1.0"?>
<ruleset name="Unlisted Posts">
	<description>Coding standards for the Unlisted Posts plugin.</description>

	<file>.</file>

	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/src/*</exclude-pattern>

	<arg value="sp"/>
	<arg name="basepath" value="."/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>

	<config name="minimum_wp_version" value="6.6"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress">
		<!-- PSR-4 file naming is used instead of WP's class-*.php convention. -->
		<exclude name="WordPress.Files.FileName"/>
		<!-- Short array syntax is preferred. -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
	</rule>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="unlisted-posts"/>
			</property>
		</properties>
	</rule>
</ruleset>
